<script>
  // ================= NAV =================
  const nav = document.getElementById('nav');
  window.addEventListener('scroll', () => nav.classList.toggle('scrolled', window.scrollY > 24));

  // ================= SCROLL REVEAL =================
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
  }, { threshold: 0.08 });
  document.querySelectorAll('.reveal').forEach((el, i) => {
    el.style.transitionDelay = (i % 4) * 70 + 'ms';
    io.observe(el);
  });


  // ================= SCREENSHOT TABS + LIGHTBOX =================
  document.querySelectorAll('.tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.tab').forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected','false'); });
      document.querySelectorAll('.shots').forEach(p => p.hidden = true);
      tab.classList.add('active'); tab.setAttribute('aria-selected','true');
      document.getElementById(tab.getAttribute('aria-controls')).hidden = false;
    });
  });

  document.querySelectorAll('.shot-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const box = document.createElement('div');
      box.className = 'lightbox';
      box.setAttribute('role', 'dialog');
      box.setAttribute('aria-label', 'Enlarged screenshot');
      const img = document.createElement('img');
      img.src = btn.dataset.full;
      img.alt = btn.querySelector('img').alt;
      box.appendChild(img);
      const close = () => { box.remove(); document.removeEventListener('keydown', onKey); };
      const onKey = (e) => { if (e.key === 'Escape') close(); };
      box.addEventListener('click', close);
      document.addEventListener('keydown', onKey);
      document.body.appendChild(box);
    });
  });

  // ================= LEAD FORM =================
  const FORM_ENDPOINT = 'https://formspree.io/f/mwlvrgnk';
  const CALENDLY_URL  = 'https://calendly.com/impactdevagency/storefront-pro';
  const WHATSAPP_NUMBER = '2349026487958'; // fallback only

  const form = document.getElementById('lead');
  const formError = document.getElementById('form-error');
  const pkgError = document.getElementById('pkg-error');
  const submitBtn = document.getElementById('submit-btn');
  const submitLabel = submitBtn.innerHTML;
  const booking = document.getElementById('booking');

  // Ad tracking: capture campaign parameters so each lead shows where it came from
  const params = new URLSearchParams(location.search);
  const tracking = {};
  ['utm_source','utm_medium','utm_campaign','utm_content','utm_term','gclid','fbclid'].forEach(k => {
    if (params.get(k)) tracking[k] = params.get(k);
  });

  function setInvalid(id, bad){
    const el = document.getElementById(id);
    if (el) el.closest('.field').classList.toggle('invalid', bad);
  }

  ['f-name','f-phone','f-email','f-type'].forEach(id => {
    document.getElementById(id).addEventListener('input', () => setInvalid(id, false));
    document.getElementById(id).addEventListener('change', () => setInvalid(id, false));
  });
  form.querySelectorAll('input[name="package"]').forEach(r => r.addEventListener('change', () => pkgError.classList.remove('show')));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form).entries());
    delete data._gotcha;

    const phoneDigits = String(data.phone || '').replace(/\D/g, '');
    const checks = {
      'f-name':  String(data.name || '').trim().length > 1,
      'f-phone': phoneDigits.length >= 7,
      'f-email': /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(data.email || '').trim()),
      'f-type':  !!data.business_type
    };
    let ok = true, firstBad = null;
    Object.entries(checks).forEach(([id, valid]) => {
      setInvalid(id, !valid);
      if (!valid){ ok = false; if (!firstBad) firstBad = id; }
    });
    const pkgChosen = !!data.package;
    pkgError.classList.toggle('show', !pkgChosen);
    if (!pkgChosen) ok = false;

    if (!ok){
      formError.textContent = 'Please complete the highlighted fields.';
      formError.classList.add('show');
      const target = firstBad ? document.getElementById(firstBad) : pkgError;
      target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }
    formError.classList.remove('show');

    const picked = form.querySelector('input[name="package"]:checked');
    const payload = {
      ...data,
      package_name: picked.dataset.name,
      package_price_ngn: picked.dataset.price || 'n/a',
      lead_source: 'StoreFront Pro ad landing page',
      page_url: location.href.split('#')[0],
      submitted_at: new Date().toISOString(),
      visitor_timezone: (Intl.DateTimeFormat().resolvedOptions().timeZone || ''),
      ...tracking,
      _subject: 'StoreFront Pro lead: ' + data.name + ' | ' + picked.dataset.name,
      _replyto: data.email
    };

    submitBtn.disabled = true;
    submitBtn.innerHTML = 'Sending…';

    try {
      const res = await fetch(FORM_ENDPOINT, {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      if (!res.ok) throw new Error('Submission failed');

      if (typeof gtag === 'function') gtag('event', 'generate_lead', { event_category: 'storefront_pro', package_name: picked.dataset.name });
      showBooking(payload);
    } catch (err) {
      const text = 'Hello ImpactDev, I would like to enquire about StoreFront Pro. I am ' + data.name + '.';
      const wa = 'https://wa.me/' + WHATSAPP_NUMBER + '?text=' + encodeURIComponent(text);
      formError.innerHTML = 'Something went wrong sending your request. Please try again, or <a href="' + wa + '" target="_blank" rel="noopener">message us on WhatsApp</a>.';
      formError.classList.add('show');
      submitBtn.disabled = false;
      submitBtn.innerHTML = submitLabel;
    }
  });

  // ================= CALENDLY (live availability, handles time zones) =================
  function showBooking(p){
    form.style.display = 'none';
    booking.classList.add('show');
    booking.scrollIntoView({ behavior: 'smooth', block: 'start' });

    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = 'https://assets.calendly.com/assets/external/widget.css';
    document.head.appendChild(link);

    const s = document.createElement('script');
    s.src = 'https://assets.calendly.com/assets/external/widget.js';
    s.async = true;
    s.onload = () => {
      const summary = 'Package: ' + p.package_name + ' | Contact via: ' + p.contact_preference + ' | Phone: ' + p.phone + (p.business_name ? ' | Business: ' + p.business_name : '');
      Calendly.initInlineWidget({
        url: CALENDLY_URL + '?hide_gdpr_banner=1&background_color=ffffff&text_color=1c0a38&primary_color=3a3068',
        parentElement: document.getElementById('calendly-embed'),
        prefill: { name: p.name, email: p.email, customAnswers: { a1: summary } },
        utm: { utmSource: p.utm_source, utmMedium: p.utm_medium, utmCampaign: p.utm_campaign, utmContent: p.utm_content, utmTerm: p.utm_term }
      });
    };
    document.body.appendChild(s);
  }

  window.addEventListener('message', (e) => {
    if (e.origin === 'https://calendly.com' && e.data && e.data.event === 'calendly.event_scheduled'){
      if (typeof gtag === 'function') gtag('event', 'schedule', { event_category: 'storefront_pro' });
      document.getElementById('booked').classList.add('show');
    }
  });
</script>

